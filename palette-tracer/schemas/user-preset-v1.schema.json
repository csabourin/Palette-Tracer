{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaletteTraceUserPresetV1",
  "type": "object",
  "required": [
    "schemaVersion",
    "presetUuid",
    "name",
    "description",
    "createdAt",
    "updatedAt",
    "scope",
    "includes",
    "configurationPatch"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "presetUuid": { "type": "string", "format": "uuid" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "scope": { "type": "string", "enum": ["structure", "palette", "full"] },
    "includes": { "type": "object" },
    "configurationPatch": { "type": "object" }
  }
}
