run = "bash scripts/replit_run.sh"
entrypoint = "palette_trace/standalone.py"
modules = ["python-3.12"]

[nix]
channel = "stable-24_05"
packages = ["libxcrypt", "pkg-config", "xsimd"]

# One port, published under the number Replit actually addresses this Repl by:
# its console and its webview both point at `:8000`, so that is where the
# interface has to be. Publishing it as external 80 instead — the default
# domain — moved it out from under the address in use and left the old one
# unreachable.
#
# What matters is that there is exactly *one* mapping. There used to be two,
# with two entry points disagreeing about which to use: the Run button bound
# 8000 while `$PORT` said 8080, so half the time the address being opened had
# nothing listening behind it — and what answers there is Replit's proxy, not
# this application, which is why it looked like a 404 from the app itself.
[[ports]]
localPort = 8000
externalPort = 8000

[env]
PYTHONUNBUFFERED = "1"
PORT = "8000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Palette Trace Web"

[[workflows.workflow]]
name = "Palette Trace Web"
author = "agent"

# The same entry point as the `run` key above. It calls the interpreter through
# the script so the dependencies are installed first: invoking
# `.pythonlibs/bin/python3 -m palette_trace.standalone` directly skipped
# `pip install -e .`, so numpy, pillow, scipy and potracer were not necessarily
# there — and a process that dies on import leaves the port empty.
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/replit_run.sh"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "webview"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
