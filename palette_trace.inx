<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Palette Trace</name>
    <id>org.inkscape.raster.palette_trace</id>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Raster"/>
        </effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">palette_trace.py</command>
    </script>
</inkscape-extension>
