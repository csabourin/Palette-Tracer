{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaletteTraceImageSettingsV1",
  "type": "object",
  "required": [
    "schemaVersion",
    "extensionVersion",
    "imageUuid",
    "source",
    "destination",
    "scanCount",
    "colorProcessing",
    "palette",
    "alpha",
    "globalTraceProfile",
    "geometry",
    "backend",
    "output",
    "generation"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "extensionVersion": { "type": "string" },
    "imageUuid": { "type": "string", "format": "uuid" },
    "scanCount": { "type": "integer", "minimum": 1, "maximum": 64 },
    "destination": {
      "type": "object",
      "required": ["id", "presetVersion"],
      "properties": {
        "id": {
          "type": "string",
          "enum": ["illustration", "logo_branding", "screen_printing", "vinyl_paper", "laser", "custom"]
        },
        "presetVersion": { "type": "integer" }
      }
    },
    "palette": {
      "type": "object",
      "required": ["entries", "layerOrder", "backgroundEntryId"],
      "properties": {
        "entries": { "type": "array" },
        "layerOrder": { "type": "array", "items": { "type": "string" } },
        "backgroundEntryId": { "type": ["string", "null"] },
        "backgroundMatching": {
          "type": "string",
          "enum": ["all_matching", "edge_connected", "transparent"]
        },
        "backgroundForegroundPolicy": {
          "description": "What becomes of a patch of the backdrop colour that the matching mode leaves in the foreground (SPEC §16.1). `hole_or_layer` keeps it as a hole wherever one can express it and gives it a layer of its own where one cannot.",
          "type": "string",
          "enum": ["hole_or_layer", "hole", "layer", "ignore"]
        }
      }
    }
  }
}
